# ---- Model weights (big files) ----
models/*
!models/.gitkeep
*.pt
*.pth
*.onnx

# ---- Results saved by the code ----
outputs/*
!outputs/.gitkeep

# ---- Editor and Windows files ----
.vscode/
Thumbs.db
desktop.ini