# ---- Virtual environment ----
.venv/

# ---- Python and Jupyter temporary files ----
__pycache__/
*.pyc
.ipynb_checkpoints/

# ---- Private photos (number plates are personal data) ----
data/my_photos/*
!data/my_photos/.gitkeep

# ---- Big downloaded datasets ----
data/datasets/*
